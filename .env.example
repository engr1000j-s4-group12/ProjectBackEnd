# Required before public deployment
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-long-random-password
DEVICE_API_TOKEN=replace-with-a-long-random-device-token
MCP_API_TOKEN=replace-with-a-long-random-mcp-token

# VLM (OpenAI Chat Completions compatible)
VLM_API_KEY=replace-with-vlm-api-key
VLM_BASE_URL=https://your-vlm-endpoint.example/v1
VLM_MODEL=your-vlm-model
VLM_TIMEOUT_SECONDS=45

# Container and HTTPS
HOST_PORT=8000
PORT=8000
GUIDE_DOMAIN=guide.example.com
FORWARDED_ALLOW_IPS=*
